{
  "name": "orb-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modular, slot-driven scheduler and calendar components for Vue 3",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./locales": {
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/locales.js"
    },
    "./style.css": "./dist/orb-scheduler.css",
    "./primeuix.css": "./dist/primeuix.css"
  },
  "sideEffects": [
    "**/*.css",
    "./src/index.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "playground:build": "vite build --config vite.playground.config.ts",
    "playground:preview": "vite preview --config vite.playground.config.ts",
    "size": "node scripts/check-size.mjs",
    "check": "run-s type-check test build-only size",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "3.13.41",
    "temporal-polyfill": "^1.0.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "publint": "^0.3.25",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "license": "MIT"
}
